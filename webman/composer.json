{
  "name": "node-list/webman-api",
  "description": "node_list 网页接口的唯一实现：PHP + webman 2.2（Workerman + Eloquent + PSR-16）",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "monolog/monolog": "^2.9",
    "vlucas/phpdotenv": "^5.6",
    "webman/cache": "^2.1",
    "webman/database": "^2.1",
    "workerman/webman-framework": "^2.1"
  },
  "autoload": {
    "psr-4": {
      "": "./"
    },
    "files": [
      "./app/functions.php"
    ]
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "workerman/webman-framework": true
    }
  },
  "scripts": {
    "test": "@php tests/run.php",
    "test:integration": "@php tests/integration.php"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
