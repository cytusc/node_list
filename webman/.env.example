# ---- 服务监听 ----
API_HOST=127.0.0.1
API_PORT=3001
# 生产可用 http://0.0.0.0:3001 直接覆盖上面的拼装结果
# API_LISTEN=http://0.0.0.0:3001

# ---- PostgreSQL（compose 的 x-environment 用同一批变量名，直接复用即可）----
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=node_explorer
PGUSER=node_explorer_ro
PGPASSWORD=
PGPOOL_MAX=8

# ---- 运行参数 ----
APP_DEBUG=false
APP_LOG_LEVEL=info
# 面板时区（PHP date 渲染偏移；库里是 timestamptz，不受它影响）
APP_TIMEZONE=Asia/Shanghai
# classification.version 判定版本，改动前先确认 ipcheck.VotingVersion
IPCHECK_VOTING_VERSION=8

# 登录（必填，未配置时节点与监控 API 拒绝访问）
AUTH_USERNAME=admin
# 使用 webman/tools/hash-password.php 生成，不存明文；值用单引号包围防止 $ 插值
AUTH_PASSWORD_HASH=
# HTTPS 生产保持 true；本地 HTTP 开发设为 false
AUTH_COOKIE_SECURE=true
