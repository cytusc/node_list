# Copy to .env on the deployment server and fill actual values.
# Docker: existing subs-check result directory on the host (required).
SUBS_CHECK_HOST_DIR=
BIND_ADDRESS=127.0.0.1
WEB_PORT=3001
# Non-container execution: path containing config/ and output/.
SUBS_CHECK_DIR=./data/sub
# Optional custom source file and SQLite database path.
# RESULTS_FILE=
# DATABASE_PATH=./data/nodes.sqlite
# Docker Qilan source: append :compose.qilan.yaml to COMPOSE_FILE.
# Absolute host path to session.txt; mounted read-only inside the container.
# QILAN_SESSION_HOST_FILE=/mnt/d/code/qilan/qilan-scraper/session.txt
# QILAN_REFRESH_INTERVAL_SECONDS=900
# QILAN_USER_AGENT=Mozilla/5.0
# Feishu custom bot webhook: pushes an alert when the Qilan session expires
# and a recovery notice once syncing resumes. Leave empty to disable.
# FEISHU_WEBHOOK_URL=
# Non-container execution: set QILAN_SESSION or QILAN_SESSION_FILE.
# QILAN_SESSION=
# QILAN_SESSION_FILE=/mnt/d/code/qilan/qilan-scraper/session.txt
# PostgreSQL: enable by setting PGHOST; other fields are then required.
PGHOST=
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=
POSTGRES_NETWORK=
# Compose files used by systemd and scheduled updates.
COMPOSE_FILE=compose.yaml:compose.subs-check.yaml
# For PostgreSQL append :compose.pgsql.yaml to COMPOSE_FILE.

# Floor on how often the PostgreSQL query tables are rebuilt, in seconds. The
# rebuild is also driven by source-file and database changes; this only bounds
# how often a burst of writes may coalesce into one rebuild.
# PROJECTION_REFRESH_SECONDS=10

# Set false to keep a locally built image until a formal release is published.
NODE_EXPLORER_AUTO_UPDATE=true

# IPPure: append :compose.ippure.yaml to COMPOSE_FILE to enable in Docker.
# Non-container execution requires a dedicated Mihomo.
# IPPURE_CONTROLLER=http://127.0.0.1:9090
# IPPURE_PROXY_URL=http://127.0.0.1:7890
# IPPURE_CONTROLLER_SECRET=
# IPPURE_CONCURRENCY=3
# IPPURE_INTERVAL_SECONDS=30
# IPPURE_API_ORIGIN=https://api.123169.xyz
# IPPURE_MIHOMO_TAG=v1.19.27

# Scheduled GitHub patrol: append :compose.patrol.yaml to COMPOSE_FILE.
# PostgreSQL also requires :compose.patrol.pgsql.yaml (after compose.pgsql.yaml).
GITHUB_PATROL_INTERVAL_SECONDS=1800
GITHUB_PATROL_CONCURRENCY=2
GITHUB_PATROL_TIMEOUT_SECONDS=12
GITHUB_PATROL_RETRY_SECONDS=10

# Network types follow IPQuality's usage/company mappings.
# Optional token with IPinfo classification/privacy fields; empty uses its public widget API.
IPINFO_TOKEN=
# Optional IP-API Pro key for HTTPS. Empty uses the requested free HTTP API.
IP_API_PRO_KEY=
# Optional personal keys. Empty uses IPQuality's public IPregistry demo and AbuseIPDB proxy.
IPREGISTRY_API_KEY=
ABUSEIPDB_API_KEY=
