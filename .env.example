# Copy to .env on the deployment server and fill actual values.
# Docker: existing subs-check result directory on the host (required).
SUBS_CHECK_HOST_DIR=
BIND_ADDRESS=127.0.0.1
WEB_PORT=3001
# Non-container execution: path containing config/ and output/.
SUBS_CHECK_DIR=./data/sub
# Optional custom source file and SQLite database path.
# RESULTS_FILE=
# DATABASE_PATH=./data/nodes.sqlite
# PostgreSQL: enable by setting PGHOST; other fields are then required.
PGHOST=
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=
POSTGRES_NETWORK=
# Compose files used by systemd and scheduled updates.
COMPOSE_FILE=compose.yaml:compose.subs-check.yaml
# For PostgreSQL append :compose.pgsql.yaml to COMPOSE_FILE.

# Set false to keep a locally built image until a formal release is published.
NODE_EXPLORER_AUTO_UPDATE=true

# IPPure: append :compose.ippure.yaml to COMPOSE_FILE to enable in Docker.
# Non-container execution requires a dedicated Mihomo.
# IPPURE_CONTROLLER=http://127.0.0.1:9090
# IPPURE_PROXY_URL=http://127.0.0.1:7890
# IPPURE_CONTROLLER_SECRET=
# IPPURE_CONCURRENCY=3
# IPPURE_API_ORIGIN=https://api.123169.xyz
# IPPURE_MIHOMO_TAG=v1.19.27
