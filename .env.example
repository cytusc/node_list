# PostgreSQL is required for all services. Redis carries task references only.
# 网页接口（node-explorer，PHP/webman）也读这一批变量：PGHOST/PGPORT/PGDATABASE/
# PGUSER/PGPASSWORD/PGPOOL_MAX 与 Go 采集器同名同义，compose 的 x-environment
# 已统一注入，无需为接口单独配一份。
PGHOST=
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=
PGPOOL_MAX=8
POSTGRES_NETWORK=
SUBS_CHECK_HOST_DIR=
SUBS_CHECK_DIR=./data/sub
BIND_ADDRESS=127.0.0.1
WEB_PORT=3001
COMPOSE_FILE=compose.yaml:compose.subs-check.yaml
NODE_EXPLORER_AUTO_UPDATE=true
# 网页接口专属（可选，都有默认值）：
#   面板时区，默认 Asia/Shanghai（PHP date 渲染偏移；库里是 timestamptz）
APP_TIMEZONE=Asia/Shanghai
#   Workerman worker 进程数，默认 4（容器里按 CPU 核数调）
# API_WORKERS=4
#   读侧缓存秒数（仅影响轮询合并，失败不缓存）
# API_COLLECTOR_CACHE_SECONDS=5
# Non-container probe workers require Redis and dedicated Mihomo controllers for each lane.
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_NAMESPACE=node-explorer
RESIDENTIAL_INTERVAL_SECONDS=300
NORMAL_INTERVAL_SECONDS=1800
# 共享内核全量测活：每轮完成并落库后空闲 30 分钟；重载等待本轮结束。
SWEEP_INTERVAL_SECONDS=1800
SWEEP_CONCURRENCY=32
# 以下快速测活间隔仅供旧模式；普通节点每 20 分钟，住宅保持 5 分钟。
FAST_INTERVAL_SECONDS=1200
# 非住宅退役节点首次失败后按 20 分钟基准退避；并发同时限制消费者和在途评估。
NORMAL_RECOVERY_INTERVAL_SECONDS=1200
NORMAL_RECOVERY_CONCURRENCY=2
# 出口两条优先级通道共享总容量；任一通道空闲时另一条可使用全部容量。
MIHOMO_EXIT_CONCURRENCY=8
# Compose 消费者上限，每通道默认 8；总执行数仍受上面的共享容量约束。
EXIT_PROVISION_HIGH_CONCURRENCY=8
EXIT_PROVISION_NORMAL_CONCURRENCY=8
# 通用并发及 controller 列表用于不使用 manager 的旧模式。
# 共享内核模式快速测活 32 路；复核 8 路、风险 2 路分别限流。
RESIDENTIAL_CONCURRENCY=2
NORMAL_CONCURRENCY=2
CONNECTIVITY_HIGH_CONCURRENCY=4
CONNECTIVITY_NORMAL_CONCURRENCY=20
# 非 Compose 启动时，直接使用下面两个出口消费者参数。
IP_SERVICE_HIGH_CONCURRENCY=8
IP_SERVICE_NORMAL_CONCURRENCY=8
# 慢车道消费者数（每优先级通道各起这么多）。risk 走 IPPure 查询、不经
# ipcheck 客户端锁，可并行；attributes 的六家 provider 调用在客户端内串行，
# 增大主要重叠数据库合并。默认均为 1，ip-service 的 Compose 默认 risk=2。
# IP_SERVICE_RISK_CONCURRENCY=2
# IP_SERVICE_ATTRIBUTES_CONCURRENCY=1
# LIFECYCLE_CONCURRENCY=1
# RECOVERY_CONCURRENCY=1
PROBE_TIMEOUT_SECONDS=12
PROBE_RETRY_SECONDS=10
LIFECYCLE_DRY_RUN=true
# CONNECTIVITY_HIGH_CONTROLLER=http://127.0.0.1:9091
# CONNECTIVITY_HIGH_PROXY_URL=http://127.0.0.1:7891
# CONNECTIVITY_NORMAL_CONTROLLER=http://127.0.0.1:9092
# CONNECTIVITY_NORMAL_PROXY_URL=http://127.0.0.1:7892
# IP_SERVICE_HIGH_CONTROLLER=http://127.0.0.1:9093
# IP_SERVICE_HIGH_PROXY_URL=http://127.0.0.1:7893
# IP_SERVICE_NORMAL_CONTROLLER=http://127.0.0.1:9094
# IP_SERVICE_NORMAL_PROXY_URL=http://127.0.0.1:7894
# Each prefix also supports _CONTROLLER_SECRET. Comma-separated instance lists must match.
IPPURE_API_ORIGIN=https://api.123169.xyz
IPINFO_TOKEN=
IP_API_PRO_KEY=
IPREGISTRY_API_KEY=
ABUSEIPDB_API_KEY=
# IP 属性服务：ip-api 批量端点（100 IP/次）的请求间隔，默认 1600 毫秒。
# 公共配额 45 请求/分钟，与单条查询共享；429 或 X-Rl=0 时自动进入配额冷却。
# IP_API_BATCH_INTERVAL_MS=1600
# Public proxy sources (HTTP/CONNECT and SOCKS5); refresh every 30 minutes.
# SOURCE_PROVIDERS=subs-check,proxio-all,Jakee-http,xyzs996-all
# PUBLIC_PROXY_REFRESH_INTERVAL_SECONDS=1800
# Optional Qilan: append :compose.qilan.yaml to COMPOSE_FILE (runs in source-ingest).
# If SOURCE_PROVIDERS is set explicitly, include qilan in that list.
# QILAN_SESSION_HOST_FILE=/absolute/path/session.txt
# QILAN_REFRESH_INTERVAL_SECONDS=900
# QILAN_USER_AGENT=Mozilla/5.0
# QILAN_SESSION_FILE=/absolute/path/session.txt
# QILAN_SESSION=
# FEISHU_WEBHOOK_URL=

# Shared kernel: generate two independent 48-character hex secrets.
MIHOMO_MANAGER_TOKEN=
MIHOMO_CONTROLLER_SECRET=
# Start in validation mode. Switch only after route isolation and proof checks.

# 4 核服务器上的默认 CPU 预算，单位为 CPU 核数；网络并发仍为 32。
MIHOMO_CPUS=1.0
MIHOMO_MANAGER_CPUS=0.5

# Registry refresh is separate from the 5-second health/controller check.
MIHOMO_REGISTRY_POLL_SECONDS=30
