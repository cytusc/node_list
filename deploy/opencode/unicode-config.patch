@@ -99,0 +100,20 @@
+    def test_reload_routes_preserves_unicode_in_file_and_controller_payload(self):
+        import maintain_pool
+        root = Path(self.temp.name)
+        (root / 'proxy').mkdir()
+        path = root / 'proxy/config.json'
+        path.write_text('{}')
+        inode = path.stat().st_ino
+        config = {'external-controller': '127.0.0.1:9090',
+                  'proxies': [{'name': '\U0001f1e8\U0001f1f3 中文'}]}
+        with patch('maintain_pool.ROOT', root), \
+             patch('maintain_pool.inspect', return_value={'State': {'Pid': 123}}), \
+             patch('maintain_pool.run') as command:
+            maintain_pool.reload_routes(config)
+        self.assertEqual(path.stat().st_ino, inode)
+        self.assertEqual(json.loads(path.read_text()), config)
+        self.assertNotIn('\\u', path.read_text())
+        payload = json.loads(command.call_args.kwargs['input'])['payload']
+        self.assertNotIn('\\u', payload)
+        self.assertEqual(json.loads(payload), config)
+
