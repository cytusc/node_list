{
  "name": "node-explorer",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"vite --host 0.0.0.0\"",
    "dev:api": "php webman/start.php start",
    "build": "tsc -b && vite build",
    "build:worker": "go -C backend build -o node-worker ./cmd/node-worker",
    "start": "php webman/start.php start",
    "test": "node --test legacy/node-server/*.test.js",
    "test:backend": "go -C backend vet ./... && go -C backend test -race ./...",
    "test:api": "php webman/composer.phar install --working-dir=webman --no-interaction && php webman/tests/run.php",
    "test:e2e": "playwright test",
    "dev:worker": "go -C backend run ./cmd/node-worker"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.12",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-popover": "^1.2.0",
    "@radix-ui/react-slot": "^1.4.0",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "express": "^5.3.0",
    "flag-icons": "^7.5.0",
    "lucide-react": "^1.55.0",
    "pg": "^8.23.1",
    "playwright-core": "^1.64.0",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "undici": "^7.30.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
