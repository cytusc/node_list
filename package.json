{
  "name": "node-explorer",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"vite --host 0.0.0.0\"",
    "dev:api": "php webman/start.php start",
    "build": "tsc -b && vite build",
    "build:attributes": "go -C backend build -o node-attributes ./cmd/node-attributes",
    "dev:attributes": "go -C backend run ./cmd/node-attributes",
    "build:exit": "go -C backend build -o node-exit ./cmd/node-exit",
    "dev:exit": "go -C backend run ./cmd/node-exit",
    "build:source": "go -C backend build -o node-source ./cmd/node-source",
    "dev:source": "go -C backend run ./cmd/node-source",
    "start": "php webman/start.php start",
    "test": "php webman/tests/run.php && php webman/tests/auth.php && php webman/tests/open-api.php",
    "test:backend": "go -C backend vet ./... && go -C backend test -race ./...",
    "test:api": "composer install --working-dir=webman --no-interaction && npm test",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "flag-icons": "^7.5.0",
    "lucide-react": "^1.55.0",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
